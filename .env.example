# Port aplikasi
PORT=3000

# Tipe Database: 'mysql' (default) atau 'postgres'
DB_DIALECT=mysql

# Endpoint RDS (contoh: database-1.cxxxxxxx.ap-southeast-1.rds.amazonaws.com)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-db-password
DB_NAME=labdb

# Aktifkan SSL jika RDS mewajibkannya (true/false)
DB_SSL=false
